# ── Telegram API credentials ──────────────────────────────────────────────
# Create YOUR OWN app at https://my.telegram.org → "API development tools".
# Do NOT use the credentials of official clients or copied from tutorials —
# it violates Telegram's ToS and can get your account banned.
TG_API_ID=
TG_API_HASH=

# ── Session ───────────────────────────────────────────────────────────────
# Created by scripts/login_userbot.py. Grants full account access — keep secret.
TG_SESSION=~/.fabella/fabella.session

# ── Ports ─────────────────────────────────────────────────────────────────
TG_BRIDGE_PORT=8086
TG_WEB_PORT=8087

# ── Chats ─────────────────────────────────────────────────────────────────
# Extra chats the userbot answers: ids or usernames, comma-separated.
# Empty = Saved Messages only.
TG_ALLOWED_CHATS=
# One extra chat id kept allowed (e.g. an old bot chat you want answered).
TG_BOT_CHAT_ID=

# ── Web console auth ──────────────────────────────────────────────────────
# Token required by /api/*. If unset, one is generated on first run.
TG_WEB_TOKEN=
# Where the auto-generated token is stored.
TG_TOKEN_PATH=~/.fabella/fabella_token.txt
